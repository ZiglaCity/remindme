# Copy to .env.local. Never commit credentials.
DATABASE_URL=
# DATABASE_DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
TESTER_ACCESS_MODE=allowlist
# Set TESTER_ACCESS_MODE=all to allow everyone; public is an equivalent alias.
# Otherwise enter exact, comma-separated tester addresses here.
TESTER_EMAIL_ALLOWLIST=
# Separate delivery approval, even when access mode is all.
SMTP_APPROVED_RECIPIENTS=
WORKER_BATCH_SIZE=25
WORKER_CONCURRENCY=5
WORKER_RUN_BUDGET_SECONDS=240
WORKER_MAX_RECOVERIES=3
PROCESSING_LEASE_SECONDS=300
SMTP_MAX_ATTEMPTS=5
SMTP_RETRY_DELAYS_SECONDS=60,300,900,3600
# Application links in emails; also required by the independent worker.
APP_URL=http://localhost:3000
# Only the guarded SMTP smoke command uses this explicitly selected destination.
SMTP_TEST_RECIPIENT=
# Set only in .env.test.local to an isolated test database.
TEST_DATABASE_URL=
